<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMM Color Layer - Settings"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Highlighted layer" FontWeight="Bold" FontSize="13"/>
        <TextBlock Text="Color" Margin="0,8,0,0"/>
        <WrapPanel x:Name="pnlHiSwatches" Margin="0,4,0,2"/>
        <DockPanel Margin="0,0,0,8">
            <Button Content="More colors..." DockPanel.Dock="Right" Width="100" Height="24" Click="OnHiCustom"/>
            <Border x:Name="brdHi" Height="24" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/>
        </DockPanel>
        <TextBlock Text="Line weight"/>
        <ComboBox x:Name="cmbHiWeight" Height="24" Margin="0,4,0,14"/>

        <Separator Margin="0,0,0,10"/>

        <TextBlock Text="Greyed-out layers" FontWeight="Bold" FontSize="13"/>
        <TextBlock Text="Color" Margin="0,8,0,0"/>
        <WrapPanel x:Name="pnlGreySwatches" Margin="0,4,0,2"/>
        <DockPanel Margin="0,0,0,8">
            <Button Content="More colors..." DockPanel.Dock="Right" Width="100" Height="24" Click="OnGreyCustom"/>
            <Border x:Name="brdGrey" Height="24" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/>
        </DockPanel>
        <CheckBox x:Name="chkHalftone" Content="Halftone" Margin="0,0,0,8"/>
        <TextBlock Text="Transparency (fills and hatches)"/>
        <DockPanel Margin="0,4,0,8">
            <TextBlock x:Name="lblTrans" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="0%"/>
            <Slider x:Name="sldTrans" Minimum="0" Maximum="100" TickFrequency="5"
                    IsSnapToTickEnabled="True" ValueChanged="OnTransChanged"/>
        </DockPanel>
        <TextBlock Text="Line weight"/>
        <ComboBox x:Name="cmbGreyWeight" Height="24" Margin="0,4,0,14"/>

        <TextBlock Text="Applies to the active view only. Revit has no line transparency, so the grey lines use halftone; transparency affects fills and hatches."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <DockPanel>
            <Button Content="Reset to defaults" DockPanel.Dock="Left" Width="120" Height="26" Click="OnResetClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick"/>
                <Button Content="Cancel" Width="80" Height="26" IsCancel="True" Click="OnCancelClick"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
