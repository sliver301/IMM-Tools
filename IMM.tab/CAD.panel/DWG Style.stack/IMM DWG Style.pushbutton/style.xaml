<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMM DWG Style"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Line weight" FontWeight="SemiBold"/>
        <ComboBox x:Name="cmbWeight" Height="24" Margin="0,4,0,12"/>

        <TextBlock Text="Line color" FontWeight="SemiBold"/>
        <WrapPanel x:Name="pnlSwatches" Margin="0,6,0,4"/>
        <DockPanel Margin="0,0,0,14">
            <Button Content="More colors..." DockPanel.Dock="Right" Width="100" Height="26" Click="OnCustomClick"/>
            <Border x:Name="brdPreview" Height="26" Margin="0,0,8,0" BorderBrush="Gray" BorderThickness="1"/>
        </DockPanel>

        <TextBlock Text="Applied to every layer of the DWG in the active view, including blocks inside blocks."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Apply" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="OnApplyClick"/>
            <Button Content="Cancel" Width="80" Height="26" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
