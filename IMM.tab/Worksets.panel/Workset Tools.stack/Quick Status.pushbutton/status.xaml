<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workset status" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="12" Foreground="{DynamicResource Fg}">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="Fg" Color="#1F2328"/>
    <SolidColorBrush x:Key="Fg2" Color="#59636E"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="Soft" Color="#F6F7F9"/>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="Margin" Value="0,0,12,6"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </Window.Resources>
  <Border Margin="14" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.22"/>
    </Border.Effect>
    <StackPanel Margin="18,14,18,14">
      <DockPanel Margin="0,0,0,10">
        <Border x:Name="chipLive" DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" Background="#E6F4EA">
          <TextBlock x:Name="txtLive" Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="#1F7A43"/>
        </Border>
        <TextBlock Text="Workset status" FontSize="15" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Model" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtModel" Style="{StaticResource Value}"/>
        <TextBlock Grid.Row="1" Text="Active" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtActive" Style="{StaticResource Value}"/>
        <TextBlock Grid.Row="2" Text="Mine" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtMine" Style="{StaticResource Value}"/>
        <TextBlock Grid.Row="3" Text="Editable" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtEditable" Style="{StaticResource Value}"/>
        <TextBlock Grid.Row="4" Text="Mapping" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtMapping" Style="{StaticResource Value}"/>
        <TextBlock Grid.Row="5" Text="Mode" Style="{StaticResource Label}"/>
        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtMode" Style="{StaticResource Value}"/>
      </Grid>
      <TextBlock x:Name="txtNote" Foreground="#E8590C" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
      <DockPanel Margin="0,12,0,0">
        <Button x:Name="btnClose" DockPanel.Dock="Right" Content="Close" Padding="14,5" Cursor="Hand" IsCancel="True"
                Background="{DynamicResource Soft}" Foreground="{DynamicResource Fg}" BorderBrush="{DynamicResource Line}"/>
        <Button x:Name="btnOpen" HorizontalAlignment="Left" Content="Open Workset Manager" Padding="14,5" Cursor="Hand"
                Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
