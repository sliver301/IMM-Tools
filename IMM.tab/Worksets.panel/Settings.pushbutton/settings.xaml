<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMM Workset Manager Settings"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="Fg" Color="#1F2328"/>
    <SolidColorBrush x:Key="Fg2" Color="#59636E"/>
    <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="Hover" Color="#F0F2F5"/>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="22,0,0,6"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,3,0,2"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,3,0,2"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Personal settings, saved on this PC only." Foreground="{DynamicResource Fg2}" Margin="0,2,0,14"/>

    <Border Style="{StaticResource CardBox}">
      <StackPanel>
        <TextBlock Text="When I place or paste elements" Style="{StaticResource Head}"/>
        <RadioButton x:Name="rbReassign" GroupName="mode" Content="Put each element on its mapped workset"/>
        <TextBlock Style="{StaticResource Hint}" Text="Your active workset stays as it is. Each new element is moved to its workset in the same step, so one Undo removes it."/>
        <RadioButton x:Name="rbFollow" GroupName="mode" Content="Same, and switch my active workset to follow"/>
        <TextBlock Style="{StaticResource Hint}" Text="While you hold a placing tool each element is moved; when you stop, the active workset switches to the workset of what you just placed."/>
        <CheckBox x:Name="chkFollowNotice" Content="Show a small notice each time the active workset follows" Margin="22,2,0,4"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBox}">
      <StackPanel>
        <TextBlock Text="Suggestion to switch workset" Style="{StaticResource Head}"/>
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="chkNudge" Content="Suggest switching after" VerticalAlignment="Center"/>
          <TextBox x:Name="tbThreshold" Margin="8,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="placements in a row on the same workset" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="Only in the first mode. A paste counts as one placement."/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBox}">
      <StackPanel>
        <TextBlock Text="Notices" Style="{StaticResource Head}"/>
        <CheckBox x:Name="chkUnmapped" Content="A category is used for the first time and has no workset"/>
        <CheckBox x:Name="chkFamily" Content="A loaded family brings a category with no workset"/>
        <CheckBox x:Name="chkOthers" Content="I work on a workset claimed by someone else"/>
        <CheckBox x:Name="chkOwner" Content="Someone worked on my worksets (shown after sync)"/>
        <CheckBox x:Name="chkMapping" Content="Mappings adopted from others, or conflicting with mine"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Notices fade after" VerticalAlignment="Center"/>
          <TextBox x:Name="tbSeconds" Margin="8,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="seconds (they pause while the mouse is over them)" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBox}">
      <StackPanel>
        <TextBlock Text="Claims" Style="{StaticResource Head}"/>
        <CheckBox x:Name="chkCheckout" Content="&quot;Claim as mine&quot; also makes the workset editable (checked out)"/>
        <TextBlock Style="{StaticResource Hint}" Text="Protects it natively in Revit. Never used for shared claims."/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="txtError" Foreground="#D1242F" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
    <DockPanel>
      <Button x:Name="btnDefaults" Style="{StaticResource Btn}" Content="Defaults" DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="btnSave" Style="{StaticResource BtnPrimary}" Content="Save" Margin="0,0,8,0" IsDefault="True"/>
        <Button x:Name="btnCancel" Style="{StaticResource Btn}" Content="Cancel" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
