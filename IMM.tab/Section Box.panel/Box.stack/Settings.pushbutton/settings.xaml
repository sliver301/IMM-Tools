<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMM Section Box Settings"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Creation offset" FontWeight="SemiBold"/>
        <TextBlock Text="Space added on every side when the box is created." Foreground="Gray" FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"/>
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="lblOffsetUnit" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="80"/>
            <TextBox x:Name="txtOffset" Height="24" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="Grow / Shrink step" FontWeight="SemiBold"/>
        <TextBlock Text="How far every face moves per click." Foreground="Gray" FontSize="11" Margin="0,2,0,4" TextWrapping="Wrap"/>
        <DockPanel Margin="0,0,0,12">
            <TextBlock x:Name="lblStepUnit" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="80"/>
            <TextBox x:Name="txtStep" Height="24" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="Box orientation" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <RadioButton x:Name="rbParallel" GroupName="mode" Margin="0,2">
            <TextBlock Text="Parallel: turn the box to follow the selected element" TextWrapping="Wrap"/>
        </RadioButton>
        <RadioButton x:Name="rbNative" GroupName="mode" Margin="0,2,0,16">
            <TextBlock Text="Native: keep the box aligned to the project axes" TextWrapping="Wrap"/>
        </RadioButton>

        <DockPanel>
            <Button Content="Defaults" Width="80" Height="26" Click="OnDefaultsClick" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="OnSaveClick"/>
                <Button Content="Cancel" Width="80" Height="26" IsCancel="True" Click="OnCancelClick"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
