<!-- Section Box History window (History, Save Box and Load Box buttons).
     The window covers the whole Revit window, almost fully transparent, so a
     click anywhere outside the bar closes it. CanvasArea is the view's
     rectangle inside it: the bar sits at its top centre and the preview
     opens under the bar. Styles and colour tokens come from imm_ui. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMM Section Box History"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" UseLayoutRounding="True" Opacity="0">
  <Window.Resources>
    <!--@STYLES@-->
  </Window.Resources>

  <Grid x:Name="Overlay">
    <Grid x:Name="CanvasArea">
      <StackPanel x:Name="Column" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">

        <Border x:Name="Bar" Background="@BG@" BorderBrush="@BORDER@" BorderThickness="1"
                CornerRadius="12" Padding="14,10,14,14">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
          </Border.Effect>
          <DockPanel>

            <!-- header -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
              <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Close}"
                      VerticalAlignment="Center" ToolTip="Close (Esc)"/>
              <CheckBox x:Name="RecordCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                        Style="{StaticResource Switch}" Content="Record"
                        ToolTip="Keep a snapshot of every new section box made in this model"/>
              <Button x:Name="SaveButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                      Style="{StaticResource Secondary}" Content="Save current box"
                      ToolTip="Add the view's section box to the saved list, with a name"/>
              <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                         FontSize="11" Foreground="@FG2@" Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Section Boxes" FontSize="13" FontWeight="SemiBold" Foreground="@FG@"
                           VerticalAlignment="Center"/>
                <Border Background="@SEG@" CornerRadius="9" Margin="14,0,0,0" Padding="1">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabRecent" GroupName="tabs" Style="{StaticResource Segment}" Content="Recent"/>
                    <RadioButton x:Name="TabSaved" GroupName="tabs" Style="{StaticResource Segment}" Content="Saved"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="HintText" Margin="14,1,0,0" FontSize="11" Foreground="@FG2@"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>

            <!-- inline name editor (save / rename) -->
            <Border x:Name="NameRow" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10"
                    Background="@TILE@" CornerRadius="9" Padding="10,8">
              <DockPanel>
                <Button x:Name="NameCancel" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Content="Cancel"/>
                <Button x:Name="NameOk" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="NameLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,10,0"
                           Foreground="@FG@" FontSize="12" Text="Save box as"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" Margin="0,0,10,0"/>
              </DockPanel>
            </Border>

            <Grid>
              <!-- Recent: pinned, divider, last 4. Transparent (not empty)
                   background so the gaps between tiles count as the row. -->
              <Grid x:Name="Tiles" Background="Transparent"/>

              <!-- Saved: search + scrolling grid -->
              <DockPanel x:Name="SavedPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBox x:Name="SearchBox" Style="{StaticResource Input}"/>
                  <TextBlock x:Name="SearchHint" Text="Search saved boxes" Margin="11,0,0,0" FontSize="13"
                             Foreground="@FG2@" Opacity="0.7" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Grid>
                  <ScrollViewer x:Name="SavedScroll" Style="{StaticResource SlimScroll}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <WrapPanel x:Name="SavedTiles" Background="Transparent"/>
                  </ScrollViewer>
                  <TextBlock x:Name="SavedEmpty" Visibility="Collapsed" Margin="0,18,0,18" FontSize="12"
                             Foreground="@FG2@" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Grid>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>

        <!-- the enlarged snapshot of the hovered tile -->
        <Border x:Name="Preview" Visibility="Collapsed" Margin="0,8,0,0" Background="@BG@"
                BorderBrush="@ACCENT@" BorderThickness="2" CornerRadius="12" Padding="6"
                IsHitTestVisible="False">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
          </Border.Effect>
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                    Background="#B0000000" CornerRadius="6" Padding="8,4">
              <TextBlock x:Name="PreviewLabel" Foreground="White" FontSize="12"/>
            </Border>
          </Grid>
        </Border>

      </StackPanel>
    </Grid>
  </Grid>
</Window>
